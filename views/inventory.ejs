<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Inventory | Smart Canteen</title><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="topbar"><a class="brand" href="/">🍽 Smart Canteen</a><nav><a href="/">Place Order</a><a href="/orders">Orders</a><a class="active" href="/inventory">Inventory</a><a href="/admin">Dashboard</a></nav></header>
<main class="wrap"><div class="page-title"><div><span class="eyebrow">STOCK CONTROL</span><h1>Inventory</h1><p class="muted">Update prices and stock. Low-stock items are highlighted.</p></div></div>
<% if (error) { %><div class="alert"><%= error %></div><% } %><% if (success) { %><div class="success">Inventory saved successfully.</div><% } %>
<section class="panel"><div class="section-head"><div><h2>Add menu item</h2><p class="muted">Create a new item for the canteen menu.</p></div></div><form class="add-form" method="POST" action="/inventory/add"><input name="name" placeholder="Item name" maxlength="120" required><input type="number" name="price" min="0" step="0.01" placeholder="Price (₹)" required><input type="number" name="stock" min="0" placeholder="Opening stock" required><input type="number" name="low_stock_limit" min="0" value="5" placeholder="Alert at" required><button class="btn">Add item</button></form></section>
<section class="panel"><div class="section-head"><h2>Current stock</h2><span class="muted"><%= items.length %> menu items</span></div><div class="table-wrap"><table><thead><tr><th>Item</th><th>Price</th><th>Available stock</th><th>Low-stock alert at</th><th>Save changes</th></tr></thead><tbody><% items.forEach(item => { %><tr class="<%= item.stock <= item.low_stock_limit ? 'warning-row' : '' %>"><td><strong><%= item.name %></strong><% if (item.stock <= item.low_stock_limit) { %><br><span class="low">⚠ Low stock</span><% } %></td><td>₹<%= Number(item.price).toFixed(2) %></td><td><%= item.stock %></td><td><%= item.low_stock_limit %></td><td><form class="inline-form" method="POST" action="/inventory/update/<%= item.id %>"><input type="number" name="price" min="0" step="0.01" value="<%= item.price %>" aria-label="Price"><input type="number" name="stock" min="0" value="<%= item.stock %>" aria-label="Stock"><input type="number" name="low_stock_limit" min="0" value="<%= item.low_stock_limit %>" aria-label="Low stock limit"><button class="btn small">Update</button></form></td></tr><% }) %></tbody></table></div></section></main><footer>Smart Canteen Management System</footer></body></html>