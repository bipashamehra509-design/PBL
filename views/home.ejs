<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Smart Canteen</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<header class="topbar"><a class="brand" href="/">🍽 Smart Canteen</a><nav><a class="active" href="/">Place Order</a><a href="/orders">Orders</a><a href="/inventory">Inventory</a><a href="/admin">Dashboard</a></nav></header>
<main class="wrap">
<section class="hero"><div><span class="eyebrow">FAST • FRESH • SIMPLE</span><h1>Your campus canteen,<br><em>made smarter.</em></h1><p>Choose your favourite food and place your order in a few clicks.</p></div><div class="hero-icon">🥗</div></section>
<% if (error) { %><div class="alert"><%= error %></div><% } %>
<section class="section-head"><div><span class="eyebrow">MENU</span><h2>Today's menu</h2></div><span class="muted"><%= items.length %> items available</span></section>
<div class="menu-grid">
<% items.forEach(item => { %>
<article class="food-card"><div class="food-icon">🍴</div><h3><%= item.name %></h3><div class="food-bottom"><strong>₹<%= Number(item.price).toFixed(2) %></strong><span class="<%= item.stock <= item.low_stock_limit ? 'low' : 'stock' %>"><%= item.stock > 0 ? item.stock + ' in stock' : 'Out of stock' %></span></div>
<% if (item.stock > 0) { %><form action="/order" method="POST" class="order-form"><input name="customer_name" placeholder="Your name" maxlength="120" required><input type="hidden" name="item_id" value="<%= item.id %>"><label>Quantity<input type="number" name="quantity" min="1" max="<%= Math.min(item.stock,50) %>" value="1" required></label><label>Order priority<select name="priority"><option value="Normal">Normal</option><option value="High">High</option><option value="Urgent">Urgent</option></select></label><button class="btn full">Place order →</button></form><% } else { %><button class="btn full disabled" disabled>Unavailable</button><% } %>
</article><% }) %>
</div></main><footer>Smart Canteen Management System · Built for campus convenience</footer></body></html>