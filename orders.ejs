<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Orders | Smart Canteen</title><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="topbar"><a class="brand" href="/">🍽 Smart Canteen</a><nav><a href="/">Place Order</a><a class="active" href="/orders">Orders</a><a href="/inventory">Inventory</a><a href="/admin">Dashboard</a></nav></header>
<main class="wrap"><div class="page-title"><div><span class="eyebrow">ORDER MANAGEMENT</span><h1>Orders</h1><p class="muted">Search orders and update their progress.</p></div><a class="btn" href="/">+ New order</a></div>
<% if (success) { %><div class="success">Order placed successfully!</div><% } %>
<form class="filters panel" method="GET" action="/orders"><input name="search" value="<%= search %>" placeholder="Search customer, item or order ID"><select name="status"><option value="">All statuses</option><% statuses.forEach(s => { %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s %></option><% }) %></select><select name="priority"><option value="">All priorities</option><% priorities.forEach(p => { %><option value="<%= p %>" <%= priority===p?'selected':'' %>><%= p %> priority</option><% }) %></select><button class="btn">Apply filters</button><a class="text-link" href="/orders">Clear</a></form>
<section class="panel"><% if (!orders.length) { %><p class="empty">No matching orders found.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Item</th><th>Total</th><th>Priority</th><th>Placed</th><th>Status</th><th>Update</th></tr></thead><tbody><% orders.forEach(o => { %><tr><td>#<%= o.id %></td><td><%= o.customer_name %></td><td><%= o.item_name %> × <%= o.quantity %></td><td>₹<%= Number(o.total).toFixed(2) %></td><td><span class="priority <%= o.priority.toLowerCase() %>"><%= o.priority %></span></td><td><%= new Date(o.created_at).toLocaleString() %></td><td><span class="badge <%= o.status.toLowerCase() %>"><%= o.status %></span></td><td><form class="inline-form" method="POST" action="/update-status/<%= o.id %>"><select name="status"><% statuses.forEach(s => { %><option value="<%= s %>" <%= o.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn small">Save</button></form></td></tr><% }) %></tbody></table></div><% } %></section></main><footer>Smart Canteen Management System</footer></body></html>