<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Dashboard | Smart Canteen</title><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="topbar"><a class="brand" href="/">🍽 Smart Canteen</a><nav><a href="/">Place Order</a><a href="/orders">Orders</a><a href="/inventory">Inventory</a><a class="active" href="/admin">Dashboard</a></nav></header>
<main class="wrap"><div class="page-title"><div><span class="eyebrow">OVERVIEW</span><h1>Admin dashboard</h1><p class="muted">A quick look at your canteen's activity.</p></div><a class="btn" href="/inventory">Manage inventory →</a></div>
<div class="stats-grid"><div class="stat-card"><span>Total orders</span><strong><%= summary.total_orders %></strong><small>All time</small></div><div class="stat-card"><span>Active orders</span><strong><%= summary.active_orders %></strong><small>Not completed or cancelled</small></div><div class="stat-card"><span>Completed sales</span><strong>₹<%= Number(summary.revenue).toFixed(2) %></strong><small>Completed orders only</small></div><div class="stat-card"><span>Low-stock items</span><strong><%= stockSummary.low_stock || 0 %></strong><small><%= stockSummary.units %> total units in stock</small></div></div>
<section class="panel"><div class="section-head"><div><span class="eyebrow">LATEST ACTIVITY</span><h2>Recent orders</h2></div><a href="/orders">View all →</a></div>
<% if (!recent.length) { %><p class="empty">No orders yet. New orders will appear here.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Item</th><th>Total</th><th>Priority</th><th>Status</th></tr></thead><tbody><% recent.forEach(o => { %><tr><td>#<%= o.id %></td><td><%= o.customer_name %></td><td><%= o.item_name %> × <%= o.quantity %></td><td>₹<%= Number(o.total).toFixed(2) %></td><td><span class="priority <%= o.priority.toLowerCase() %>"><%= o.priority %></span></td><td><span class="badge <%= o.status.toLowerCase() %>"><%= o.status %></span></td></tr><% }) %></tbody></table></div><% } %></section></main><footer>Smart Canteen Management System</footer></body></html>